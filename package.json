{
  "name": "mundo-natural",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "test:production": "node scripts/smoke-production.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:export": "node scripts/export-schema.mjs",
    "admin:setup": "node scripts/admin-setup.mjs",
    "test:database": "node --test tests/database.integration.mjs",
    "test:browser": "playwright test",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "verify": "npm test && npm run typecheck && npm run check:launch -- --code-only && npm audit --omit=dev --audit-level=high && npm run build && npm run test:production"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "geist": "^1.3.1",
    "lucide-react": "^0.454.0",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^7"
  },
  "engines": {
    "node": ">=22.0.0 <25"
  }
}
