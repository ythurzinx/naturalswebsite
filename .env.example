# Hostinger: painel da aplicação Node.js -> Environment variables.
# Nunca coloque um segredo em NEXT_PUBLIC_ nem faça commit do arquivo .env.local.
APP_URL=https://seu-dominio.com.br
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_ENV=production
# Opcional para o checkout; necessário para receber Webhooks autenticados.
# Mercado Pago -> Suas integrações -> Webhooks -> Assinatura secreta.
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: use a mesma origem HTTPS de APP_URL para os metadados sociais.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Painel e persistência: crie um MySQL dedicado no hPanel.
# Use 127.0.0.1 no MySQL local da Hostinger. Codifique caracteres especiais da senha na URL.
DATABASE_URL=mysql://USUARIO:SENHA@127.0.0.1:3306/BANCO
# Gere estes valores em seu terminal com npm run admin:setup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_TOTP_SECRET=
